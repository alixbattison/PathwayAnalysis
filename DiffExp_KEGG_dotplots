safe_message("Non-control conditions: ", paste(non_control, collapse = ", "))

# =============================================================================
# ── DIFFERENTIAL EXPRESSION ANALYSIS (Metabolite Level) ──────────────────────
# =============================================================================

compute_differential_metabolites <- function(df, sample_cols, col_conds,
                                             non_control, control_cols,
                                             p_thresh = P_THRESHOLD,
                                             log2fc_thresh = LOG2FC_THRESHOLD,
                                             min_n = MIN_N) {
  safe_message("Computing differentially expressed metabolites...")
  safe_message("  Thresholds: p < ", p_thresh,
               ", |log2FC| >= ", round(log2fc_thresh, 3))
  
  de_results <- list()
  
  for (cond in non_control) {
    cond_cols <- names(col_conds[!is.na(col_conds) & col_conds == cond])
    safe_message("  DE analysis: ", cond, " vs Control (",
                 length(cond_cols), " vs ", length(control_cols), " samples)")
    
    res <- df %>%
      rowwise() %>%
      mutate(
        ctrl_values = list(na.omit(c_across(all_of(control_cols)))),
        cond_values = list(na.omit(c_across(all_of(cond_cols)))),
        n_ctrl      = length(ctrl_values),
        n_cond      = length(cond_values)
      ) %>%
      ungroup() %>%
      filter(n_ctrl >= min_n, n_cond >= min_n) %>%
      mutate(
        median_ctrl = map_dbl(ctrl_values, ~ median(.x, na.rm = TRUE)),
        median_cond = map_dbl(cond_values, ~ median(.x, na.rm = TRUE)),
        fold_change = median_cond / pmax(median_ctrl, 1e-9),
        log2_fc     = log2(pmax(fold_change, 1e-9)),
        p_value     = map2_dbl(cond_values, ctrl_values, ~ {
          tryCatch(
            wilcox.test(.x, .y, exact = FALSE)$p.value,
            error = function(e) 1
          )
        }),
        fdr         = p.adjust(p_value, method = "BH"),
        direction   = case_when(
          log2_fc > 0 ~ "Up",
          log2_fc < 0 ~ "Down",
          TRUE        ~ "None"
        ),
        # Significant: raw p < threshold AND |log2FC| >= threshold
        # abs(log2_fc) handles both up- and down-regulated correctly
        significant = (p_value < p_thresh) & (abs(log2_fc) >= log2fc_thresh),
        comparison  = paste0(cond, " vs Control")
      ) %>%
      select(all_of(NAME_COL), comparison, median_ctrl, median_cond,
             fold_change, log2_fc, p_value, fdr, direction, significant) %>%
      arrange(p_value)
    
    n_sig <- sum(res$significant, na.rm = TRUE)
    n_up  <- sum(res$significant & res$direction == "Up", na.rm = TRUE)
    n_dn  <- sum(res$significant & res$direction == "Down", na.rm = TRUE)
    n_p   <- sum(res$p_value < p_thresh, na.rm = TRUE)
    safe_message("    → ", n_p, " metabolites with p < ", p_thresh)
    safe_message("    → ", n_sig, " DE metabolites (", n_up, " up, ", n_dn,
                 " down) after |log2FC| >= ", round(log2fc_thresh, 3), " filter")
    
    # Fallback: if zero DE, relax to p-value only
    if (n_sig == 0 && n_p > 0) {
      safe_message("    ⚠ 0 DE metabolites with FC filter — falling back to p < ",
                   p_thresh, " only")
      res <- res %>% mutate(significant = p_value < p_thresh)
      n_sig <- sum(res$significant, na.rm = TRUE)
      safe_message("    → After fallback: ", n_sig, " DE metabolites")
    }
    
    de_results[[cond]] <- res
  }
  
  de_results
}

# =============================================================================
# ── KEGG PATHWAY MAPPING ──────────────────────────────────────────────────────
# =============================================================================

map_kegg <- function(df, name_col, api_pause = API_PAUSE_SEC) {
  
  if (!requireNamespace("KEGGREST", quietly = TRUE))
    stop("KEGGREST not installed. Run: BiocManager::install('KEGGREST')")
  library(KEGGREST)
  
  compound_names <- df[[name_col]]
  safe_message("KEGG: querying ", length(compound_names), " compound names...")
  
  cpd_cache <- list()
  
  query_kegg_cpd <- function(nm) {
    if (!is.null(cpd_cache[[nm]])) return(cpd_cache[[nm]])
    Sys.sleep(api_pause)
    ids <- tryCatch({
      hits <- keggFind("compound", nm)
      if (length(hits) > 0) names(hits) else {
        short <- word(nm, 1)
        hits2 <- keggFind("compound", short)
        if (length(hits2) > 0) names(hits2) else character(0)
      }
    }, error = function(e) character(0))
    cpd_cache[[nm]] <<- ids
    ids
  }
  
  df_cpd <- df %>%
    mutate(
      kegg_cpd_ids = map(.data[[name_col]], query_kegg_cpd),
      kegg_cpd     = map_chr(kegg_cpd_ids,
                             ~ if (length(.x) > 0) .x[[1]] else NA_character_)
    ) %>%
    filter(!is.na(kegg_cpd))
  
  safe_message("KEGG: matched ", nrow(df_cpd), " / ", nrow(df), " compounds to KEGG IDs")
  
  safe_message("KEGG: fetching pathways for ", nrow(df_cpd), " matched compounds...")
  
  # --- Primary method: batch keggLink (much faster and more reliable) ---
  # keggLink("pathway", "cpd") retrieves ALL compound→pathway links at once
  safe_message("KEGG: attempting batch pathway lookup via keggLink...")
  batch_links <- tryCatch({
    all_links <- keggLink("pathway", "compound")
    if (length(all_links) > 0) {
      tibble(
        kegg_cpd   = sub("^cpd:", "", names(all_links)),
        pathway_id = sub("^path:", "", as.character(all_links))
      )
    } else {
      NULL
    }
  }, error = function(e) {
    safe_message("KEGG: batch keggLink failed: ", conditionMessage(e))
    NULL
  })
  
  if (!is.null(batch_links) && nrow(batch_links) > 0) {
    safe_message("KEGG: batch lookup returned ", nrow(batch_links), " total links")
    
    # Strip "cpd:" prefix from our compound IDs to match
    df_cpd_clean <- df_cpd %>%
      mutate(kegg_cpd_clean = sub("^cpd:", "", kegg_cpd))
    
    df_pw <- df_cpd_clean %>%
      inner_join(
        batch_links %>% rename(kegg_cpd_clean = kegg_cpd),
        by = "kegg_cpd_clean",
        relationship = "many-to-many"
      ) %>%
      select(-kegg_cpd_clean)
    
    safe_message("KEGG: matched ", n_distinct(df_pw$pathway_id),
                 " pathways for ", n_distinct(df_pw$kegg_cpd), " of our compounds")
    
  } else {
    # --- Fallback: per-compound keggLink ---
    safe_message("KEGG: falling back to per-compound keggLink...")
    pw_id_cache <- list()
    
    get_cpd_pathways <- function(cpd_id) {
      if (!is.null(pw_id_cache[[cpd_id]])) return(pw_id_cache[[cpd_id]])
      Sys.sleep(api_pause)
      pws <- tryCatch({
        links <- keggLink("pathway", cpd_id)
        if (length(links) > 0) {
          unique(sub("^path:", "", as.character(links)))
        } else {
          character(0)
        }
      }, error = function(e) {
        tryCatch({
          info <- keggGet(cpd_id)[[1]]
          if (!is.null(info$PATHWAY)) names(info$PATHWAY) else character(0)
        }, error = function(e2) character(0))
      })
      pw_id_cache[[cpd_id]] <<- pws
      pws
    }
    
    df_pw <- df_cpd %>%
      mutate(pathway_ids = map(kegg_cpd, get_cpd_pathways)) %>%
      filter(lengths(pathway_ids) > 0) %>%
      unnest(pathway_ids) %>%
      rename(pathway_id = pathway_ids)
  }
  
  safe_message("KEGG: found ", n_distinct(df_pw$pathway_id),
               " unique pathways across ", n_distinct(df_pw$kegg_cpd), " compounds")
  
  # Diagnostic: show a few sample pathway IDs to verify format
  if (nrow(df_pw) > 0) {
    sample_ids <- head(unique(df_pw$pathway_id), 5)
    safe_message("KEGG: sample pathway IDs: ", paste(sample_ids, collapse = ", "))
  } else {
    safe_message("KEGG: WARNING — 0 compound → pathway links found!")
    safe_message("KEGG: This may indicate keggLink/keggGet API issues.")
    # Return empty df with correct columns
    return(df_cpd %>%
             mutate(pathway_id = NA_character_, pathway_name = NA_character_) %>%
             filter(FALSE))
  }
  
  # ── Resolve ALL pathway IDs to full human-readable names ──────────────────
  pw_ids_unique <- unique(df_pw$pathway_id)
  safe_message("KEGG: resolving FULL pathway names for ", length(pw_ids_unique),
               " unique pathway IDs...")
  
  pw_name_cache_env <- new.env(parent = emptyenv())
  
  pw_name_map <- setNames(
    sapply(pw_ids_unique, function(pid) {
      resolve_kegg_pathway_name(pid, pw_name_cache_env)
    }),
    pw_ids_unique
  )
  
  still_coded <- pw_name_map[grepl("^(map|mmu|hsa|ko|ec|rn)\\d", pw_name_map)]
  if (length(still_coded) > 0) {
    safe_message("Retrying ", length(still_coded), " unresolved pathway IDs...")
    for (pid in names(still_coded)) {
      alt_id <- sub("^(mmu|hsa|ko|ec|rn)", "map", pid)
      alt_name <- resolve_kegg_pathway_name(alt_id, pw_name_cache_env)
      if (!grepl("^(map|mmu|hsa|ko|ec|rn)\\d", alt_name)) {
        pw_name_map[[pid]] <- alt_name
      }
    }
  }
  
  df_pw <- df_pw %>%
    mutate(pathway_name = unname(pw_name_map[pathway_id]))
  
  n_before <- nrow(df_pw)
  df_pw <- df_pw %>%
    filter(!grepl("^(map|mmu|hsa|ko|ec|rn)\\d{4,}", pathway_name))
  n_removed <- n_before - nrow(df_pw)
  if (n_removed > 0) {
    safe_message("Removed ", n_removed, " rows with unresolvable pathway IDs")
  }
  
  safe_message("KEGG: final long table: ", nrow(df_pw), " compound × pathway rows")
  
  # Remove plant pathways and overly generic terms
  safe_message("KEGG: filtering plant and generic pathways...")
  df_pw <- filter_pathways(df_pw, "pathway_name")
  safe_message("KEGG: after filtering: ", nrow(df_pw), " compound × pathway rows, ",
               n_distinct(df_pw$pathway_name), " unique pathways")
  
  df_pw
}

# =============================================================================
# ── HMDB PATHWAY MAPPING ──────────────────────────────────────────────────────
# =============================================================================

map_hmdb <- function(df, name_col, api_pause = API_PAUSE_SEC) {
  
  if (!requireNamespace("metaboliteIDmapping", quietly = TRUE))
    stop("metaboliteIDmapping not installed. Run: BiocManager::install('metaboliteIDmapping')")
  library(metaboliteIDmapping)
  
  safe_message("HMDB: loading metaboliteIDmapping table...")
  id_tbl <- mappingTable()
  
  id_lower <- id_tbl %>%
    mutate(.name_lower = tolower(Name)) %>%
    select(.name_lower, HMDB) %>%
    distinct() %>%
    filter(!is.na(HMDB), HMDB != "")
  
  df_hmdb <- df %>%
    mutate(.name_lower = tolower(.data[[name_col]])) %>%
    left_join(id_lower, by = ".name_lower") %>%
    select(-.name_lower) %>%
    filter(!is.na(HMDB))
  
  safe_message("HMDB: matched ", nrow(df_hmdb), " / ", nrow(df), " compounds to HMDB IDs")
  
  hmdb_ids_unique <- unique(df_hmdb$HMDB)
  safe_message("HMDB: querying REST API for ", length(hmdb_ids_unique), " unique HMDB IDs...")
  
  pw_cache <- list()
  
  query_hmdb_pws <- function(hmdb_id) {
    if (!is.null(pw_cache[[hmdb_id]])) return(pw_cache[[hmdb_id]])
    Sys.sleep(api_pause)
    pws <- tryCatch({
      url  <- paste0("https://hmdb.ca/metabolites/", hmdb_id, ".json")
      resp <- GET(url, timeout(20))
      if (status_code(resp) != 200) return(character(0))
      data <- fromJSON(content(resp, "text", encoding = "UTF-8"), flatten = TRUE)
      bio  <- data$biological_properties$pathways
      if (is.null(bio) || nrow(bio) == 0) return(character(0))
      unique(bio$name[!is.na(bio$name)])
    }, error = function(e) character(0))
    pw_cache[[hmdb_id]] <<- pws
    pws
  }
  
  df_pw <- df_hmdb %>%
    mutate(pathway_names = map(HMDB, query_hmdb_pws)) %>%
    filter(lengths(pathway_names) > 0) %>%
    unnest(pathway_names) %>%
    rename(pathway_name = pathway_names) %>%
    filter(!is.na(pathway_name), nchar(pathway_name) > 0)
  
  safe_message("HMDB: final long table: ", nrow(df_pw), " compound × pathway rows")
  
  # Remove plant pathways and overly generic terms
  safe_message("HMDB: filtering plant and generic pathways...")
  df_pw <- filter_pathways(df_pw, "pathway_name")
  safe_message("HMDB: after filtering: ", nrow(df_pw), " compound × pathway rows, ",
               n_distinct(df_pw$pathway_name), " unique pathways")
  
  df_pw
}

# =============================================================================
# ── PATHWAY ENRICHMENT ANALYSIS (ORA + Mann-Whitney) ─────────────────────────
# =============================================================================

compute_pathway_enrichment <- function(df_long, de_results, df_all,
                                       sample_cols, col_conds,
                                       non_control, control_cols,
                                       min_n = MIN_N, min_cpds = MIN_COMPOUNDS) {
  
  all_metabolites  <- unique(df_all[[NAME_COL]])
  n_background     <- length(all_metabolites)
  mapped_metabolites <- unique(df_long[[NAME_COL]])
  
  safe_message("  Background: ", n_background, " total metabolites, ",
               length(mapped_metabolites), " mapped to pathways")
  
  results <- list()
  
  for (cond in non_control) {
    cond_cols <- names(col_conds[!is.na(col_conds) & col_conds == cond])
    safe_message("  Enrichment: ", cond, " vs Control")
    
    # ── Get DE metabolite names (case-insensitive matching) ─────────────────
    de_df <- de_results[[cond]]
    de_names_raw <- de_df %>%
      filter(significant == TRUE) %>%
      pull(all_of(NAME_COL))
    de_names_lower <- tolower(trimws(de_names_raw))
    
    n_de <- length(de_names_lower)
    safe_message("    → ", n_de, " DE metabolites available for ORA")
    
    # ── Build pathway → metabolite list (with lowercased names for matching) ─
    pathway_compounds <- df_long %>%
      mutate(.name_lower = tolower(trimws(.data[[NAME_COL]]))) %>%
      group_by(pathway_name) %>%
      summarise(
        pathway_metabolites = list(unique(.data[[NAME_COL]])),
        pathway_metab_lower = list(unique(.name_lower)),
        n_pathway           = n_distinct(.data[[NAME_COL]]),
        .groups             = "drop"
      ) %>%
      filter(n_pathway >= min_cpds)
    
    safe_message("    → ", nrow(pathway_compounds), " pathways with >= ",
                 min_cpds, " compounds")
    
    # ── Debug: check how many DE metabolites are in any pathway at all ──────
    all_pw_metabs_lower <- unique(unlist(pathway_compounds$pathway_metab_lower))
    n_de_in_any_pw <- sum(de_names_lower %in% all_pw_metabs_lower)
    safe_message("    → ", n_de_in_any_pw, " / ", n_de,
                 " DE metabolites found in at least one pathway")
    
    # ── ORA (Fisher's exact test) per pathway ───────────────────────────────
    ora_results <- pathway_compounds %>%
      mutate(
        de_in_pathway = map_int(pathway_metab_lower,
                                ~ sum(.x %in% de_names_lower)),
        # 2x2 contingency table:
        #                  In_Pathway   Not_In_Pathway
        # DE               a            c
        # Not_DE           b            d
        ora_pvalue = map2_dbl(de_in_pathway, n_pathway, function(a, k) {
          cc <- pmax(n_de - a, 0L)    # DE not in pathway
          bb <- pmax(k - a, 0L)       # in pathway but not DE
          dd <- pmax(n_background - a - bb - cc, 0L)
          mat <- matrix(c(a, cc, bb, dd), nrow = 2, byrow = FALSE)
          tryCatch(
            fisher.test(mat, alternative = "greater")$p.value,
            error = function(e) 1
          )
        }),
        enrichment_score = ifelse(
          n_de > 0 & n_pathway > 0,
          (de_in_pathway / n_pathway) / (n_de / n_background),
          0
        ),
        de_metabolites_in_pathway = map_chr(pathway_metabolites, ~ {
          found <- .x[tolower(trimws(.x)) %in% de_names_lower]
          if (length(found) == 0) "" else paste(found, collapse = "; ")
        })
      ) %>%
      select(-pathway_metab_lower)
    
    n_ora_hit <- sum(ora_results$de_in_pathway > 0, na.rm = TRUE)
    safe_message("    → ORA: ", n_ora_hit, " / ", nrow(ora_results),
                 " pathways contain ≥1 DE metabolite")
    
    # ── Mann-Whitney U (intensity-based) per pathway ────────────────────────
    mw_results <- df_long %>%
      group_by(pathway_name) %>%
      summarise(
        n_compounds = n_distinct(.data[[NAME_COL]]),
        ctrl_vals   = list(na.omit(unlist(across(all_of(control_cols))))),
        cond_vals   = list(na.omit(unlist(across(all_of(cond_cols))))),
        .groups     = "drop"
      ) %>%
      filter(
        n_compounds >= min_cpds,
        lengths(ctrl_vals) >= min_n,
        lengths(cond_vals) >= min_n
      ) %>%
      mutate(
        mw_pvalue = map2_dbl(cond_vals, ctrl_vals, ~ {
          tryCatch(
            wilcox.test(.x, .y, exact = FALSE)$p.value,
            error = function(e) 1
          )
        }),
        fold_enrichment = map2_dbl(cond_vals, ctrl_vals, ~ {
          med_c <- median(.y, na.rm = TRUE)
          median(.x, na.rm = TRUE) / max(med_c, 1e-9)
        }),
        log2_fold = log2(pmax(fold_enrichment, 1e-6)),
        direction = ifelse(log2_fold > 0, "Enriched", "Depleted")
      ) %>%
      select(-ctrl_vals, -cond_vals)
    
    n_mw_sig <- sum(mw_results$mw_pvalue < 0.05, na.rm = TRUE)
    safe_message("    → MW: ", n_mw_sig, " pathways with p < 0.05")
    
    # ── Merge ORA and MW ───────────────────────────────────────────────────
    # Handle empty results: if either ORA or MW is empty, the full_join
    # produces NA columns with wrong types. Force character for direction.
    if (nrow(mw_results) > 0) {
      mw_for_join <- mw_results %>%
        mutate(direction = as.character(direction)) %>%
        select(pathway_name, n_compounds, fold_enrichment, log2_fold,
               mw_pvalue, direction)
    } else {
      # Create empty tibble with correct types
      mw_for_join <- tibble(
        pathway_name = character(), n_compounds = integer(),
        fold_enrichment = double(), log2_fold = double(),
        mw_pvalue = double(), direction = character()
      )
    }
    
    combined <- ora_results %>%
      select(pathway_name, n_pathway, de_in_pathway, enrichment_score,
             ora_pvalue, de_metabolites_in_pathway, pathway_metabolites) %>%
      full_join(mw_for_join, by = "pathway_name") %>%
      mutate(
        n_compounds          = coalesce(n_pathway, n_compounds),
        de_in_pathway        = coalesce(de_in_pathway, 0L),
        enrichment_score     = coalesce(enrichment_score, 0),
        ora_pvalue           = coalesce(ora_pvalue, 1),
        mw_pvalue            = coalesce(mw_pvalue, 1),
        fold_enrichment      = coalesce(fold_enrichment, 1),
        log2_fold            = coalesce(log2_fold, 0),
        direction            = ifelse(is.na(direction), "None", direction),
        de_metabolites_in_pathway = ifelse(is.na(de_metabolites_in_pathway),
                                           "", de_metabolites_in_pathway),
        ora_fdr              = p.adjust(ora_pvalue, method = "BH"),
        mw_fdr               = p.adjust(mw_pvalue, method = "BH"),
        combined_pvalue      = pmin(ora_pvalue, mw_pvalue, na.rm = TRUE),
        neg_log10_p          = -log10(combined_pvalue + 1e-300),
        significant          = (ora_pvalue < 0.05) | (mw_pvalue < 0.05)
      ) %>%
      select(-pathway_metabolites, -n_pathway) %>%
      arrange(combined_pvalue)
    
    n_sig <- sum(combined$significant, na.rm = TRUE)
    n_p05 <- sum(combined$combined_pvalue < 0.05, na.rm = TRUE)
    safe_message("    → Final: ", n_sig, " significant (raw p < 0.05 either test)")
    safe_message("    → Final: ", n_p05, " pathways with combined p < 0.05")
    
    results[[cond]] <- combined
  }
  
  results
}

# =============================================================================
# ── ENRICHMENT DOT PLOT ──────────────────────────────────────────────────────
# =============================================================================
# Saves one figure per condition per database (e.g., KEGG_dotplot_Cancer.png)

make_enrichment_dotplot <- function(results, db_label, top_n = TOP_N_PLOT,
                                    width = PLOT_WIDTH, height = PLOT_HEIGHT,
                                    dpi = PLOT_DPI) {
  
  saved_files <- character()
  
  for (i in seq_along(results)) {
    cond      <- names(results)[i]
    res       <- results[[cond]]
    cond_safe <- gsub("[^A-Za-z0-9_]", "_", cond)  # filesystem-safe name
    
    # Filter and pick top pathways
    plot_data <- res %>%
      filter(n_compounds >= MIN_COMPOUNDS) %>%
      filter(!grepl("^(map|mmu|hsa|ko|ec|rn)\\d{4,}", pathway_name)) %>%
      filter(!grepl(PLANT_REGEX, pathway_name, perl = TRUE)) %>%
      filter(!grepl(GENERIC_REGEX, pathway_name, perl = TRUE)) %>%
      slice_min(combined_pvalue, n = top_n, with_ties = FALSE)
    
    if (nrow(plot_data) == 0) {
      safe_message("  No pathways to plot for ", cond, " — skipping")
      next
    }
    
    # x-axis = enrichment ratio (-log10 p-value)
    # color  = p-value (continuous gradient, low p = significant)
    # size   = DE metabolite count in pathway
    if (any(plot_data$de_in_pathway > 0, na.rm = TRUE)) {
      plot_data <- plot_data %>%
        mutate(size_val = pmax(de_in_pathway, 1))
      size_lab <- "Count"
    } else {
      plot_data <- plot_data %>%
        mutate(size_val = n_compounds)
      size_lab <- "Count"
    }
    
    # Use FULL pathway names — no truncation
    plot_data <- plot_data %>%
      mutate(
        x_val      = neg_log10_p,
        color_val  = combined_pvalue,
        pw_display = pathway_name
      ) %>%
      arrange(x_val) %>%
      mutate(pw_label = factor(pw_display, levels = pw_display))
    
    p <- ggplot(plot_data, aes(x = x_val, y = pw_label)) +
      geom_point(aes(size = size_val, color = color_val), alpha = 0.85) +
      scale_color_gradient(high = "#56B4E9", low = "#D55E00",
                           name = "p-value",
                           labels = scales::scientific) +
      scale_size_continuous(range = c(5, 12), name = size_lab,
                            breaks = function(x) unique(round(pretty(x, 4)))) +
      labs(
        title    = paste0(db_label, " — ", cond, "  vs  Control"),
        subtitle = paste0("Dot size = DE metabolite count  ·  ",
                          "Color = p-value  ·  ",
                          "ORA + Mann-Whitney U  ·  Top ", top_n, " pathways"),
        x        = expression(Enrichment~Ratio~~(-log[10](italic(p)))),
        y        = NULL
      ) +
      theme_minimal(base_size = 11) +
      theme(
        plot.title         = element_text(face = "bold", size = 13,
                                          hjust = 0.5, margin = margin(b = 4)),
        plot.subtitle      = element_text(size = 9, hjust = 0.5,
                                          color = "#555555", margin = margin(b = 10)),
        axis.text.y        = element_text(size = 9),
        axis.text.x        = element_text(size = 9),
        axis.title.x       = element_text(size = 10, margin = margin(t = 6)),
        panel.grid.major.x = element_line(color = "#DDDDDD", linewidth = 0.4),
        panel.grid.major.y = element_line(color = "#EEEEEE", linewidth = 0.3),
        panel.grid.minor   = element_blank(),
        legend.position    = "right",
        legend.key.size    = unit(0.4, "cm"),
        legend.text        = element_text(size = 8),
        legend.title       = element_text(size = 9),
        plot.margin        = margin(10, 16, 10, 10)
      )
    
    # Save individual PNG and SVG
    png_file <- paste0(db_label, "_dotplot_", cond_safe, ".png")
    svg_file <- paste0(db_label, "_dotplot_", cond_safe, ".svg")
    
    ggsave(png_file, plot = p, width = width, height = height,
           dpi = dpi, bg = "white")
    safe_message("Saved: ", png_file)
    
    ggsave(svg_file, plot = p, width = width, height = height,
           device = "svg", bg = "white")
    safe_message("Saved: ", svg_file)
    
    saved_files <- c(saved_files, png_file, svg_file)
    
    print(p)
  }
  
  invisible(saved_files)
}

# =============================================================================
# ── EXPORT PATHWAY ENRICHMENT RESULTS (CSV) ──────────────────────────────────
# =============================================================================

export_enrichment_csv <- function(results, out_file, db_label) {
  all_rows <- bind_rows(lapply(names(results), function(cond) {
    results[[cond]] %>%
      mutate(Comparison = paste0(cond, " vs Control")) %>%
      transmute(
        Comparison                = Comparison,
        Pathway_Name              = pathway_name,
        N_Metabolites_in_Pathway  = n_compounds,
        DE_Metabolites_in_Pathway = de_in_pathway,
        Enrichment_Score          = round(enrichment_score, 4),
        Fold_Enrichment           = round(fold_enrichment, 4),
        Log2_Fold_Change          = round(log2_fold, 4),
        ORA_PValue                = signif(ora_pvalue, 6),
        ORA_FDR                   = signif(ora_fdr, 6),
        MannWhitney_PValue        = signif(mw_pvalue, 6),
        MannWhitney_FDR           = signif(mw_fdr, 6),
        Combined_PValue           = signif(combined_pvalue, 6),
        Neg_Log10_PValue          = round(neg_log10_p, 4),
        Direction                 = direction,
        Significant               = significant,
        DE_Metabolites_List       = de_metabolites_in_pathway,
        Database                  = db_label
      )
  })) %>%
    arrange(Comparison, Combined_PValue)
  
  # Safety: remove coded IDs, plant pathways, and generic terms
  coded <- grepl("^(map|mmu|hsa|ko|ec|rn)\\d{4,}", all_rows$Pathway_Name)
  plant <- grepl(PLANT_REGEX, all_rows$Pathway_Name, perl = TRUE)
  generic <- grepl(GENERIC_REGEX, all_rows$Pathway_Name, perl = TRUE)
  remove <- coded | plant | generic
  if (any(remove)) {
    safe_message("Removing ", sum(remove),
                 " rows (coded IDs / plant / generic) from CSV output")
    all_rows <- all_rows[!remove, ]
  }
  
  write.csv(all_rows, out_file, row.names = FALSE)
  safe_message("Saved enrichment CSV: ", out_file, " (", nrow(all_rows), " rows)")
  invisible(all_rows)
}

# =============================================================================
# ── EXCEL EXPORT ──────────────────────────────────────────────────────────────
# =============================================================================

export_excel <- function(results_list, de_results, out_file) {
  
  wb <- createWorkbook()
  
  .hdr <- function(bg, fc = "white")
    createStyle(fontName = "Arial", fontSize = 10, fontColour = fc,
                fgFill = bg, halign = "CENTER", valign = "CENTER",
                textDecoration = "bold", wrapText = TRUE,
                border = "Bottom", borderColour = "#CCCCCC")
  
  .write <- function(wb, sname, df, bg, note = NULL) {
    sname <- substr(sname, 1, 31)
    addWorksheet(wb, sname, gridLines = TRUE)
    r0 <- 1L
    if (!is.null(note)) {
      writeData(wb, sname, note, startRow = 1, startCol = 1)
      addStyle(wb, sname,
               createStyle(fontColour = "#666666", fontSize = 9,
                           fontName = "Arial", italic = TRUE),
               rows = 1, cols = 1)
      mergeCells(wb, sname, cols = 1:ncol(df), rows = 1)
      r0 <- 2L
    }
    writeDataTable(wb, sname, df, startRow = r0, startCol = 1,
                   tableStyle = "none", withFilter = TRUE,
                   headerStyle = .hdr(bg))
    n <- nrow(df)
    if (n > 0) {
      for (r in seq_len(n)) {
        fg <- if (r %% 2 == 0) "#F5F5F5" else "#FFFFFF"
        addStyle(wb, sname,
                 createStyle(fgFill = fg, fontName = "Arial", fontSize = 9),
                 rows = r0 + r, cols = 1:ncol(df),
                 gridExpand = TRUE, stack = TRUE)
      }
    }
    for (ci in which(sapply(df, is.numeric))) {
      fmt <- if (grepl("pvalue|p_value|P_Value|fdr|FDR", names(df)[ci], ignore.case = TRUE))
        "0.000000" else "0.0000"
      addStyle(wb, sname,
               createStyle(numFmt = fmt, fontName = "Arial", fontSize = 9),
               rows = (r0 + 1):(r0 + n), cols = ci,
               gridExpand = TRUE, stack = TRUE)
    }
    widths <- pmin(
      sapply(seq_along(df), function(i)
        max(nchar(as.character(c(names(df)[i], df[[i]]))), na.rm = TRUE) * 1.15),
      52
    )
    setColWidths(wb, sname, cols = seq_along(df), widths = widths)
    freezePane(wb, sname, firstActiveRow = r0 + 1)
  }
  
  .comp_colors <- c(
    "Cancer vs Control"          = "C0392B",
    "Torpor vs Control"          = "117A65",
    "Torpor + Cancer vs Control" = "8E44AD"
  )
  
  # ── DE Metabolites ────────────────────────────────────────────────────────
  de_combined <- bind_rows(de_results) %>%
    select(all_of(NAME_COL), comparison, median_ctrl, median_cond,
           fold_change, log2_fc, p_value, fdr, direction, significant) %>%
    rename(Metabolite = all_of(NAME_COL), Comparison = comparison,
           Median_Control = median_ctrl, Median_Condition = median_cond,
           Fold_Change = fold_change, Log2_FC = log2_fc,
           P_Value = p_value, FDR = fdr, Direction = direction,
           Significant = significant)
  
  .write(wb, "DE Metabolites", de_combined, "2C3E50",
         note = paste0("DE metabolites | Mann-Whitney U | p < ", P_THRESHOLD,
                       " & |log2FC| >= ", round(LOG2FC_THRESHOLD, 3)))
  
  de_sig <- de_combined %>% filter(Significant == TRUE)
  if (nrow(de_sig) > 0) {
    .write(wb, "DE Significant Only", de_sig, "E74C3C",
           note = "Significant DE metabolites only")
  }
  
  # ── Pathway enrichment sheets ─────────────────────────────────────────────
  for (db in names(results_list)) {
    results <- results_list[[db]]
    
    all_combined <- bind_rows(lapply(names(results), function(cond) {
      results[[cond]] %>%
        mutate(Comparison = paste0(cond, " vs Control")) %>%
        transmute(
          Comparison, Pathway = pathway_name,
          N_Compounds = n_compounds, DE_in_Pathway = de_in_pathway,
          Enrichment_Score = enrichment_score,
          Fold_Enrichment = fold_enrichment,
          Log2_Fold_Change = log2_fold,
          ORA_P_Value = ora_pvalue, ORA_FDR = ora_fdr,
          MW_P_Value = mw_pvalue, MW_FDR = mw_fdr,
          Combined_P_Value = combined_pvalue,
          Neg_Log10_P = neg_log10_p,
          Direction = direction, Significant = significant,
          DE_Metabolites = de_metabolites_in_pathway
        )
    })) %>%
      filter(!grepl("^(map|mmu|hsa|ko|ec|rn)\\d{4,}", Pathway)) %>%
      filter(!grepl(PLANT_REGEX, Pathway, perl = TRUE)) %>%
      filter(!grepl(GENERIC_REGEX, Pathway, perl = TRUE))
    
    for (cond in names(results)) {
      comp  <- paste0(cond, " vs Control")
      color <- .comp_colors[comp] %||% "34495E"
      sub   <- filter(all_combined, Comparison == comp) %>% select(-Comparison)
      .write(wb, paste0(db, " ", comp), sub, color,
             note = paste0(db, " | ", comp, " | Full pathway names"))
    }
    
    .write(wb, paste0(db, " All"), all_combined, "34495E",
           note = paste0(db, " | All comparisons"))
    
    # Enrichment Score pivot
    pivot_es <- all_combined %>%
      select(Comparison, Pathway, Enrichment_Score) %>%
      pivot_wider(names_from = Comparison, values_from = Enrichment_Score,
                  values_fill = 0) %>%
      mutate(.abs = apply(across(-Pathway), 1, function(x) max(abs(x), na.rm = TRUE))) %>%
      arrange(desc(.abs)) %>% select(-.abs)
    .write(wb, paste0(db, " EnrichScore Pvt"), pivot_es, "E67E22",
           note = "Enrichment scores (full pathway names)")
    
    # -log10(p) pivot
    pivot_p <- all_combined %>%
      select(Comparison, Pathway, Neg_Log10_P) %>%
      pivot_wider(names_from = Comparison, values_from = Neg_Log10_P,
                  values_fill = 0) %>%
      mutate(.mx = apply(across(-Pathway), 1, max, na.rm = TRUE)) %>%
      arrange(desc(.mx)) %>% select(-.mx)
    .write(wb, paste0(db, " NegLog10P Pvt"), pivot_p, "C0392B",
           note = "-log10(p-value) (full pathway names)")
  }
  
  saveWorkbook(wb, out_file, overwrite = TRUE)
  safe_message("Saved Excel: ", out_file)
}

