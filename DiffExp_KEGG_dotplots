  "biosynthesis of.*type II polyketide",
  "biosynthesis of siderophore",
  "C5-Branched dibasic acid",
  "two.component system"
)
PLANT_REGEX <- paste0("(?i)(", paste(PLANT_PATHWAY_PATTERNS, collapse = "|"), ")")

# ── Generic "Metabolic pathways" → more granular naming ─────────────────────
# KEGG map01100 "Metabolic pathways" is an umbrella term covering everything.
# map01110 "Biosynthesis of secondary metabolites" is similarly broad.
# These are too generic to be informative. Remove them so the more specific
# sub-pathway entries (which are always present alongside them) are shown.
GENERIC_PATHWAY_PATTERNS <- c(
  "^Metabolic pathways$",
  "^Biosynthesis of secondary metabolites$",
  "^Microbial metabolism in diverse environments$",
  "^Carbon metabolism$",
  "^2-Oxocarboxylic acid metabolism$",
  "^Biosynthesis of amino acids$",
  "^Biosynthesis of cofactors$",
  "^Metabolic pathways - .*"
)
GENERIC_REGEX <- paste0("(", paste(GENERIC_PATHWAY_PATTERNS, collapse = "|"), ")")

# Clean pathway results: remove plant pathways and overly generic terms
filter_pathways <- function(df, pathway_col = "pathway_name") {
  n_before <- nrow(df)
  
  df_clean <- df %>%
    filter(!grepl(PLANT_REGEX, .data[[pathway_col]], perl = TRUE)) %>%
    filter(!grepl(GENERIC_REGEX, .data[[pathway_col]], perl = TRUE))
  
  n_plant   <- n_before - nrow(df %>% filter(!grepl(PLANT_REGEX, .data[[pathway_col]], perl = TRUE)))
  n_generic <- nrow(df %>% filter(!grepl(PLANT_REGEX, .data[[pathway_col]], perl = TRUE))) - nrow(df_clean)
  
  if (n_plant > 0)   safe_message("    Removed ", n_plant, " plant/non-mammalian pathway entries")
  if (n_generic > 0) safe_message("    Removed ", n_generic, " overly generic pathway entries")
  
  df_clean
}

