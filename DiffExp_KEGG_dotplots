# ── USER CONFIGURATION ────────────────────────────────────────────────────────
# =============================================================================

INPUT_FILE    <- "test_plasma_HILIC_rawintensities.xlsx"
SHEET_NAME    <- "Sheet1"
NAME_COL      <- "Name"
SAMPLE_PREFIX <- "Plasma_"

CONDITION_MAP <- list(
  "^(NN|C)$" = "Control",
  "^NC$"      = "Cancer",
  "^TC$"      = "Torpor + Cancer",
  "^TN$"      = "Torpor"
)

MIN_N         <- 3
MIN_COMPOUNDS <- 2
API_PAUSE_SEC <- 0.35

# Differential expression thresholds
# A metabolite is DE if: p_value < P_THRESHOLD AND abs(log2FC) >= LOG2FC_THRESHOLD
# Using raw p-value as primary gate since FDR can be overly conservative with
# small sample sizes typical in metabolomics.
P_THRESHOLD      <- 0.05   # Raw p-value cutoff
FDR_THRESHOLD    <- 0.25   # Relaxed FDR; used only as secondary info
LOG2FC_THRESHOLD <- 0.585  # log2(1.5); set to 0 to use p-value only

# Which database to run: "KEGG", "HMDB", or "BOTH"
RUN_DATABASE  <- "BOTH"

TOP_N_PLOT    <- 20

# Output files
# Dot plots: one file PER CONDITION (e.g., "KEGG_dotplot_Cancer.png")
# Pattern: {db}_dotplot_{condition}.{ext}
OUT_EXCEL     <- "differential_enrichment_API.xlsx"
OUT_DE_CSV    <- "differentially_expressed_metabolites.csv"
OUT_KEGG_ENRICH_CSV <- "KEGG_pathway_enrichment_results.csv"
OUT_HMDB_ENRICH_CSV <- "HMDB_pathway_enrichment_results.csv"
PLOT_WIDTH    <- 14   # single panel width (inches) — wide enough for full pathway names
PLOT_HEIGHT   <- 10
PLOT_DPI      <- 180

