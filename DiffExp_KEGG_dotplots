safe_message <- function(...) message("[", format(Sys.time(), "%H:%M:%S"), "] ", ...)

parse_condition <- function(col_name, prefix, cond_map) {
  base <- sub(paste0("^", prefix), "", col_name)
  code <- str_extract(base, "^[A-Za-z]+")
  if (is.na(code)) return(NA_character_)
  for (pat in names(cond_map)) {
    if (grepl(pat, toupper(code), perl = TRUE)) return(cond_map[[pat]])
  }
  NA_character_
}

resolve_kegg_pathway_name <- function(pathway_id, cache_env) {
  if (exists(pathway_id, envir = cache_env)) {
    return(get(pathway_id, envir = cache_env))
  }
  resolved_name <- tryCatch({
    Sys.sleep(API_PAUSE_SEC)
    info <- KEGGREST::keggGet(pathway_id)[[1]]
    nm <- info$NAME
    if (is.null(nm) || length(nm) == 0) {
      pathway_id
    } else {
      # KEGG pathway names end with " - Organism name (common name)"
      # e.g. "D-Glutamine and D-glutamate metabolism - Homo sapiens (human)"
      # We must strip ONLY the organism suffix, not dashes within the name.
      #
      # Strategy: match " - " followed by a known organism pattern at the end.
      # The organism part is always "Genus species" optionally followed by
      # "(common name)" at the very end of the string.
      cleaned <- nm[1] %>%
        # Remove " - Genus species (common name)" at end of string
        # Genus = capital letter + lowercase; species = lowercase word
        str_remove("\\s+-\\s+[A-Z][a-z]+\\s+[a-z]+.*$") %>%
        trimws()
      if (nchar(cleaned) == 0) pathway_id else cleaned
    }
  }, error = function(e) pathway_id)
  assign(pathway_id, resolved_name, envir = cache_env)
  resolved_name
}

# ── Plant / non-mammalian pathway blacklist ─────────────────────────────────
# These are KEGG pathways specific to plants, fungi, or non-animal organisms.
# They appear because KEGG compound→pathway links are organism-agnostic.
